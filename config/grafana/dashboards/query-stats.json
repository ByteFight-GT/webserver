            "matcher": { "id": "byName", "options": "total_ms" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "pct_total" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "calls" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "rows" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Most Frequently Called Queries",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efg8z7fol3klcb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efg8z7fol3klcb" },
          "format": "table",
          "rawSql": "SELECT\n  LEFT(query, 120) AS query,\n  calls,\n  round(mean_exec_time::numeric, 2) AS mean_ms,\n  round(total_exec_time::numeric, 2) AS total_ms,\n  round(rows::numeric / NULLIF(calls, 0), 1) AS avg_rows_per_call\nFROM pg_stat_statements\nORDER BY calls DESC\nLIMIT 20",

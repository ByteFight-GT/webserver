{
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "p50 Query Latency",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
          "expr": "quantile(0.50, pg_stat_top_queries_mean_exec_time_seconds) * 1000",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 Query Latency",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
          "expr": "quantile(0.95, pg_stat_top_queries_mean_exec_time_seconds) * 1000",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 Query Latency",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
          "expr": "quantile(0.99, pg_stat_top_queries_mean_exec_time_seconds) * 1000",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Slowest Queries by Mean Execution Time",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
          "expr": "topk(20, pg_stat_top_queries_mean_exec_time_seconds * 1000)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["queryid", "query", "Value"] } } },
        { "id": "organize", "options": { "renameByName": { "Value": "mean_ms" } } },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "mean_ms", "desc": true }] } }
      ],
      "options": { "footer": { "show": false }, "showHeader": true },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "query" },
            "properties": [{ "id": "custom.width", "value": 600 }]
          },
          {
            "matcher": { "id": "byName", "options": "mean_ms" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "queryid" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Highest Total Execution Time (where your DB spends most wall-clock time)",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
          "expr": "topk(20, pg_stat_top_queries_total_exec_time_seconds * 1000)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["queryid", "query", "Value"] } } },
        { "id": "organize", "options": { "renameByName": { "Value": "total_ms" } } },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "total_ms", "desc": true }] } }
      ],
      "options": { "footer": { "show": false }, "showHeader": true },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "query" },
            "properties": [{ "id": "custom.width", "value": 600 }]
          },
          {
            "matcher": { "id": "byName", "options": "total_ms" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "queryid" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Most Frequently Called Queries",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-bytefight" },
          "expr": "topk(20, pg_stat_top_queries_calls)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["queryid", "query", "Value"] } } },
        { "id": "organize", "options": { "renameByName": { "Value": "calls" } } },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "calls", "desc": true }] } }
      ],
      "options": { "footer": { "show": false }, "showHeader": true },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "query" },
            "properties": [{ "id": "custom.width", "value": 600 }]
          },
          {
            "matcher": { "id": "byName", "options": "calls" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-BlPu" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "queryid" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "text",
      "title": "Notes",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "**Data source:** Prometheus scrapes `pg_stat_statements` via `postgres_exporter` every 60s. Grafana reads from Prometheus — no direct query load on the primary database.\n\n**p50/p95/p99** — Percentiles of *mean execution time across the top 100 query shapes by total time*. Not per-invocation percentiles — those require application-level histogram instrumentation (e.g. Micrometer).\n\n**Reset stats** — `SELECT pg_stat_statements_reset();` clears all counters. Prometheus will reflect the reset on the next 60s scrape."
      }
    }
  ],
  "refresh": "5m",
  "schemaVersion": 38,
  "tags": ["observability", "postgres", "performance"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PostgreSQL Query Performance",
  "uid": "pg-query-perf",
  "version": 1
}

    {
      "id": 4,
      "type": "table",
      "title": "Slowest Queries by Mean Execution Time",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efg8z7fol3klcb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efg8z7fol3klcb" },
          "format": "table",
          "rawSql": "SELECT\n  LEFT(query, 120) AS query,\n  calls,\n  round(mean_exec_time::numeric, 2) AS mean_ms,\n  round(stddev_exec_time::numeric, 2) AS stddev_ms,\n  round(min_exec_time::numeric, 2) AS min_ms,\n  round(max_exec_time::numeric, 2) AS max_ms,\n  round(total_exec_time::numeric, 2) AS total_ms,\n  rows\nFROM pg_stat_statements\nWHERE calls > 5\nORDER BY mean_exec_time DESC\nLIMIT 20",
          "editorMode": "code"
        }
      ],
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "mean_ms", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "query" },
            "properties": [
              { "id": "custom.width", "value": 550 },
              { "id": "custom.displayMode", "value": "color-text" }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*_ms$" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "mean_ms" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "color",
                "value": { "mode": "continuous-GrYlRd" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "calls" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "rows" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Highest Total Execution Time (where your DB spends most wall-clock time)",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 10 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efg8z7fol3klcb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efg8z7fol3klcb" },
          "format": "table",
          "rawSql": "SELECT\n  LEFT(query, 120) AS query,\n  calls,\n  round(total_exec_time::numeric, 2) AS total_ms,\n  round(mean_exec_time::numeric, 2) AS mean_ms,\n  round((total_exec_time / NULLIF(SUM(total_exec_time) OVER (), 0) * 100)::numeric, 1) AS pct_total,\n  round(total_plan_time::numeric, 2) AS total_plan_ms,\n  rows\nFROM pg_stat_statements\nORDER BY total_exec_time DESC\nLIMIT 20",
          "editorMode": "code"
        }
      ],
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "total_ms", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "query" },
            "properties": [{ "id": "custom.width", "value": 550 }]
          },
